# Set in a trusted server environment, NEVER commit a real key.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
# Deliberately disabled by default. Set a small positive cap after verifying free credits.
NEBIUS_MAX_LIVE_CALLS=0
# Local-only default. A public deployment requires access controls and cost limits.
HOST=127.0.0.1
PORT=8765
